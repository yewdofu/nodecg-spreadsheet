{
	"name": "nodecg-spreadsheet",
	"version": "1.0.0",
	"packageManager": "pnpm",
	"scripts": {
		"start": "nodecg start",
		"build": "vite build",
		"dev": "run-p dev:*",
		"dev:tsc": "tsc -b src/browser src/extension -w --preserveWatchOutput",
		"dev:vite": "vite",
		"dev:nodecg": "nodecg start",
		"generate-schema-types": "nodecg schema-types -o ./src/types/generated",
		"clean": "trash node_modules/.cache && trash dashboard && trash extension",
		"typecheck": "tsc -p src/browser && tsc -p src/extension",
		"test": "tsx --test tests/*.test.ts",
		"format": "biome check --write",
		"dev:format": "biome check --write --unsafe"
	},
	"nodecg": {
		"compatibleRange": "^2.5.0",
		"graphics": [],
		"dashboardPanels": [
			{
				"name": "Spreadsheet",
				"title": "スプレッドシート連携",
				"width": 8,
				"file": "Spreadsheet.html",
				"workspace": "スプレッドシート",
				"headerColor": "#525F78"
			}
		]
	},
	"devDependencies": {
		"@nodecg/types": "^2.8.0",
		"@types/luxon": "^3.7.5",
		"@types/obs-studio": "^2.17.2",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.1",
		"globby": "^14.1.0",
		"npm-run-all": "^4.1.5",
		"rollup": "^4.63.1",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-node-externals": "^7.1.3",
		"trash-cli": "^6.0.0",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.12",
		"@mdi/react": "^1.6.1",
		"@nodecg/react-hooks": "^1.0.3",
		"google-auth-library": "^11.0.2",
		"luxon": "^3.7.2",
		"nodecg": "^2.8.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tslib": "^2.8.1"
	}
}
